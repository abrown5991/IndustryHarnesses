{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadKBDocsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::energy-grid-harness-kb-docs",
        "arn:aws:s3:::energy-grid-harness-kb-docs/*"
      ]
    },
    {
      "Sid": "InvokeEmbeddingModel",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel"
      ],
      "Resource": "arn:aws:bedrock:*::foundation-model/amazon.titan-embed-text-v2:0"
    }
  ]
}
